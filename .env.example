# Frontend server-side proxy target.
# In local development, point this to your platform backend.
# In production, set this on the frontend hosting service.
BACKEND_API_BASE_URL=http://localhost:8000

# Optional: only set this if you intentionally want the browser
# to call the backend directly instead of using the Next.js proxy.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
